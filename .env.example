# ---------------------------------------------------------------------------
# Madara - configuration locale (exemple). Copiez ce fichier en .env
# et adaptez les valeurs. Ne versionnez jamais le .env.
# ---------------------------------------------------------------------------

# --- Securite ---------------------------------------------------------------
# Generez une cle avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changez-moi-en-production-avec-une-cle-de-64-caracteres-minimum
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Base de donnees (PostgreSQL) ------------------------------------------
POSTGRES_DB=madara
POSTGRES_USER=madara
POSTGRES_PASSWORD=madara
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TEST_DB=test_madara

# --- Taches de fond (Redis + Celery) ---------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Localisation ----------------------------------------------------------
TIME_ZONE=Africa/Casablanca
DEFAULT_TAX_RATE=0.00

# --- Notifications ---------------------------------------------------------
# console | meta | twilio  (console = journal, aucun envoi reel)
WHATSAPP_PROVIDER=console

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@madara.local
DEFAULT_FROM_NAME=Madara Clinique

# WhatsApp Cloud API (provider=meta)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_API_VERSION=v21.0

# Twilio (provider=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Divers ----------------------------------------------------------------
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=15
CORS_ALLOWED_ORIGINS=